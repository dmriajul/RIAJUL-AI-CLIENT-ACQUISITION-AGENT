    "AuditLog": {
      "sheet_name": "Audit Log",
      "description": "One row per CRM change — immutable, append-only",
      "id_field": "Log ID",
      "id_prefix": "LOG",
      "append_only": true,
      "fields": {
        "Log ID": {
          "type": "string",
          "required": true,
          "auto_generated": true,
          "format": "LOG-{NNN}",
          "description": "Unique identifier"
        },
        "Timestamp": {
          "type": "datetime",
          "required": true,
          "auto_generated": true,
          "description": "When change occurred (ISO 8601)"
        },
        "Actor": {
          "type": "string",
          "required": true,
          "enum": ["Agent", "Riajul", "System"],
          "description": "Who made the change"
        },
        "Action": {
          "type": "string",
          "required": true,
          "enum": [
            "CREATE", "READ", "UPDATE", "ARCHIVE", "MERGE",
            "STAGE_CHANGE", "STATUS_CHANGE", "BLOCK", "UNBLOCK",
            "APPROVE", "REJECT", "SEND", "RECEIVE", "SCHEDULE",
            "COMPLETE", "SKIP", "CANCEL"
          ],
          "description": "What action was taken"
        },
        "Entity Type": {
          "type": "string",
          "required": true,
          "enum": ["Company", "Contact", "Prospect", "Conversation", "ReplyAnalysis", "Followup", "Meeting", "Proposal"],
          "description": "Which entity was changed"
        },
        "Entity ID": {
          "type": "string",
          "required": true,
          "description": "ID of the changed record"
        },
        "Field": {
          "type": "string",
          "required": false,
          "description": "Which field was changed"
        },
        "Previous Value": {
          "type": "string",
          "required": false,
          "description": "Value before change"
        },
        "New Value": {
          "type": "string",
          "required": false,
          "description": "Value after change"
        },
        "Reason": {
          "type": "string",
          "required": false,
          "description": "Why change was made"
        },
        "Context": {
          "type": "string",
          "required": false,
          "description": "Additional context (JSON)"
        }
      }
    }
  },

  "global_rules": {
    "id_generation": {
      "format": "{PREFIX}-{NNN}",
      "padding": 3,
      "auto_increment": true
    },
    "timestamp_format": "ISO 8601 (YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)",
    "deletion_policy": "No destructive deletion. Use Archive status or status change.",
    "duplicate_handling": "Detect and flag, never silently create duplicates",
    "do_not_contact_enforcement": "Absolute block on all outbound communication",
    "audit_requirement": "Every mutation must generate an audit log entry"
  }
